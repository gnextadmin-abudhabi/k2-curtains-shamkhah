---
import { business } from '../../../data/business';
import { serviceTypes } from '../../../data/serviceTypes';
import { serviceAreas, getNearbyAreas } from '../../../data/serviceAreas';
import type { ServiceType } from '../../../data/serviceTypes';
import type { ServiceArea } from '../../../data/serviceAreas';
import { serviceUrl, areaUrl, comboUrl, contactUrl } from '../../../lib/urls';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../components/SeoFaq.astro';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';
import SeoServiceAreas from '../../../components/SeoServiceAreas.astro';
import SeoTestimonials from '../../../components/SeoTestimonials.astro';
import { generateSeoContent } from '../../../data/seoContent';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  const paths = [];
  for (const area of serviceAreas) {
    for (const service of serviceTypes) {
      paths.push({
        params: { area: area.slug, service: service.slug },
        props: { area, service },
      });
    }
  }
  return paths;
}

interface Props {
  area: ServiceArea;
  service: ServiceType;
}

const { area, service } = Astro.props;
const nearbyAreas = getNearbyAreas(area);
const nearbyNames = nearbyAreas.map((a) => a.name).join(', ');

const seo = generateSeoContent(service.slug, area.slug);

const pageTitle = seo.title;
const pageDescription = seo.metaDescription;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}${comboUrl(area.slug, service.slug)}#service`,
      name: `${service.name} in ${area.name}`,
      description: `${service.description} Serving homes and villas in ${area.name}, ${area.county} and surrounding communities.`,
      provider: {
        '@type': 'HomeGoodsStore',
        '@id': `${business.website}/#business`,
        name: business.name,
        telephone: business.phone,
        url: business.website,
        address: {
          '@type': 'PostalAddress',
          streetAddress: business.address.street,
          addressLocality: business.address.city,
          addressRegion: business.address.state,
          addressCountry: 'AE',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: business.coordinates.lat,
          longitude: business.coordinates.lng,
        },
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
            opens: '10:00',
            closes: '18:00',
          },
        ],
      },
      areaServed: [
        {
          '@type': 'City',
          name: area.name,
          containedInPlace: {
            '@type': 'AdministrativeArea',
            name: area.county,
          },
        },
      ],
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: service.priceRange.min,
        highPrice: service.priceRange.max,
        priceCurrency: 'AED',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}/services/` },
        { '@type': 'ListItem', position: 3, name: area.name, item: `${business.website}${areaUrl(area.slug)}` },
        { '@type': 'ListItem', position: 4, name: service.name },
      ],
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${business.website}${comboUrl(area.slug, service.slug)}`}
  schema={schema}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: area.name, href: areaUrl(area.slug) },
      { label: service.name },
    ]}
  />

  <!-- Hero with background image -->
  <section class="relative isolate">
    <div class="absolute inset-0 -z-10">
      <img
        src={service.image}
        alt={`${service.name} in ${area.name}`}
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950/90 via-charcoal-950/70 to-charcoal-950/40" />
    </div>
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
      <div class="max-w-2xl animate-fade-up">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur">
          <Icon name={service.icon} class="size-4" />
          {service.name} in {area.name}
        </div>
        <h1 class="mt-6 font-display text-4xl text-white sm:text-5xl lg:text-6xl">
          {seo.h1}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-white/80">
          {seo.intro}
        </p>
        {service.priceRange.min > 0 || service.priceRange.max > 0 ? (
          <div class="mt-8 inline-flex items-center gap-2 rounded-lg bg-white/10 px-5 py-3 text-sm font-medium text-white ring-1 ring-white/20 backdrop-blur">
            <Icon name="lucide:banknote" class="size-4 text-accent-400" />
            Typical project range: AED {service.priceRange.min.toLocaleString()} – AED {service.priceRange.max.toLocaleString()}
          </div>
        ) : null}
      </div>
    </div>
  </section>

  <!-- Description -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <h2 class="font-display text-2xl text-charcoal-950 sm:text-3xl">
        Expert {service.name} Serving {area.name} and {area.county}
      </h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-charcoal-600">
        <p>{service.description}</p>
        <p>
          At {business.name}, we have been helping families in {area.name} and the greater {area.county} area transform their homes with premium curtains, blinds, flooring, and upholstery. As a locally based home décor specialist, we understand the unique needs of villa and apartment owners in this region. {area.description}
        </p>
        {nearbyAreas.length > 0 && (
          <p>
            In addition to {area.name}, our {service.name.toLowerCase()} service covers nearby communities including {nearbyNames}. No matter where your home is located, you can count on fast response times and professional workmanship from our team.
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Price -->
  {service.priceRange.min > 0 || service.priceRange.max > 0 ? (
    <section class="bg-charcoal-50 py-20 lg:py-28">
      <div class="mx-auto max-w-3xl px-5 lg:px-8">
        <div class="rounded-2xl border border-charcoal-100 bg-white p-8 lg:p-12">
          <h2 class="font-display text-2xl text-charcoal-950 sm:text-3xl">
            What Does {service.name} Cost in {area.name}?
          </h2>
          <div class="mt-8 flex items-baseline gap-3">
            <span class="font-display text-4xl text-brand-600 md:text-5xl">
              AED {service.priceRange.min.toLocaleString()}
            </span>
            <span class="text-2xl text-charcoal-300">–</span>
            <span class="font-display text-4xl text-brand-600 md:text-5xl">
              AED {service.priceRange.max.toLocaleString()}
            </span>
          </div>
          <p class="mt-4 text-sm text-charcoal-500">
            Typical project range for {service.name.toLowerCase()} in {area.name}. Final cost depends on window sizes, materials, fabric choice, and complexity. Volume pricing available for full-home packages.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <div class="flex items-center gap-2 text-sm text-charcoal-600">
              <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
              <span>Free home consultation</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-charcoal-600">
              <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
              <span>No hidden fees</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-charcoal-600">
              <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
              <span>Written quotation</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : null}

  <!-- Process Steps: Vertical Timeline -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <h2 class="font-display text-3xl text-charcoal-950 sm:text-4xl">
        Our {service.name} Process
      </h2>
      <p class="mt-4 text-charcoal-600">
        Every project follows a clear, proven process so you always know what to expect.
      </p>

      <div class="relative mt-12">
        <div class="absolute left-[15px] top-2 bottom-2 w-px bg-brand-200 md:left-[19px]" />
        {service.processSteps.map((step, index) => (
          <div class="relative flex gap-6 pb-12 last:pb-0">
            <div class="relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white md:size-10">
              {index + 1}
            </div>
            <div class="flex-1 pt-1">
              <h3 class="font-display text-lg text-charcoal-950 md:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-charcoal-600 md:text-base">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-charcoal-50 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="font-display text-3xl text-charcoal-950 sm:text-4xl">
        Why Choose {business.name} in {area.name}?
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-charcoal-100 bg-white p-8 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="lucide:check-circle" class="size-6" />
          </div>
          <h3 class="mt-5 font-semibold text-charcoal-950">End-to-End Service</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
            From free measurement and fabric selection to stitching and installation, we handle every step.
          </p>
        </div>

        <div class="rounded-2xl border border-charcoal-100 bg-white p-8 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="lucide:map-pin" class="size-6" />
          </div>
          <h3 class="mt-5 font-semibold text-charcoal-950">Locally Based</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
            Showroom in Abu Dhabi with fast delivery and installation across {area.county}.
          </p>
        </div>

        <div class="rounded-2xl border border-charcoal-100 bg-white p-8 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="lucide:clock" class="size-6" />
          </div>
          <h3 class="mt-5 font-semibold text-charcoal-950">Fast Response</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
            {area.responseTime} response time to {area.name}. We respect your schedule.
          </p>
        </div>

        <div class="rounded-2xl border border-charcoal-100 bg-white p-8 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="lucide:badge-check" class="size-6" />
          </div>
          <h3 class="mt-5 font-semibold text-charcoal-950">Quality Guaranteed</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
            We stand behind every product with quality checks at every stage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Areas -->
  {nearbyAreas.length > 0 && (
    <section class="bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <h2 class="font-display text-3xl text-charcoal-950 sm:text-4xl">
          {service.name} in Nearby Areas
        </h2>
        <p class="mt-4 text-charcoal-600">
          We also serve homes and villas near {area.name}.
        </p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {nearbyAreas.map((nearby) => (
            <a
              href={comboUrl(nearby.slug, service.slug)}
              class="group rounded-xl border border-charcoal-100 bg-white p-6 transition-all hover:border-brand-200 hover:shadow-md"
            >
              <div class="flex items-center gap-3">
                <Icon name="lucide:map-pin" class="size-5 text-brand-600" />
                <span class="font-semibold text-charcoal-800 group-hover:text-brand-700">
                  {nearby.name}
                </span>
              </div>
              <p class="mt-2 text-sm text-charcoal-500">{nearby.county}</p>
              <p class="mt-1 text-xs text-charcoal-400">Response time: {nearby.responseTime}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Banner -->
  <section class="bg-charcoal-950">
    <div class="mx-auto max-w-4xl px-5 py-20 text-center lg:px-8 lg:py-28">
      <h2 class="font-display text-3xl text-white sm:text-4xl">
        Ready to Schedule {service.name} in {area.name}?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-charcoal-300">
        Whether you need a single window treatment or a full home makeover, our team is here to help. Contact us today for a free consultation and written quotation.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={business.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-brand-700"
        >
          <Icon name="lucide:message-circle" class="size-5" />
          WhatsApp {business.phone}
        </a>
        <a
          href={contactUrl()}
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
        >
          <Icon name="lucide:mail" class="size-5" />
          Request a Quotation
        </a>
      </div>
    </div>
  </section>

  <!-- SEO Components -->
  <div class="bg-charcoal-50">
    <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
      <SeoRelatedLinks area={area} service={service} />
    </div>
  </div>

  <div class="border-t border-charcoal-100 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
      <SeoServiceAreas currentArea={area} service={service} />
    </div>
  </div>

  {seo.testimonials.length > 0 && (
    <div class="border-t border-charcoal-100 bg-charcoal-50">
      <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
        <SeoTestimonials testimonials={seo.testimonials} />
      </div>
    </div>
  )}

  {seo.faqs.length > 0 && (
    <div class="border-t border-charcoal-100 bg-white">
      <SeoFaq faqs={seo.faqs} heading={`Frequently Asked Questions About ${service.name} in ${area.name}`} />
    </div>
  )}
</BaseLayout>
