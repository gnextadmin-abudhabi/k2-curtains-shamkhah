---
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes, getServiceBySlug } from '../../data/serviceTypes';
import { serviceAreas } from '../../data/serviceAreas';
import { serviceUrl, comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';
import SeoTestimonials from '../../components/SeoTestimonials.astro';
import { generateServiceSeoContent } from '../../data/seoContent';

import type { ServiceType } from '../../data/serviceTypes';

export function getStaticPaths() {
  return serviceTypes.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceType;
}

const { service } = Astro.props;
const seo = generateServiceSeoContent(service.slug);

const pageTitle = seo.title;
const metaDescription = seo.metaDescription;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}${serviceUrl(service.slug)}#service`,
      name: service.name,
      description: service.description,
      provider: {
        '@type': 'HomeGoodsStore',
        '@id': `${business.website}/#business`,
        name: business.name,
        telephone: business.phone,
        url: business.website,
        address: {
          '@type': 'PostalAddress',
          streetAddress: business.address.street,
          addressLocality: business.address.city,
          addressRegion: business.address.state,
          addressCountry: 'AE',
        },
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
            opens: '10:00',
            closes: '18:00',
          },
        ],
      },
      areaServed: serviceAreas.map((area) => ({
        '@type': 'City',
        name: area.name,
        containedInPlace: {
          '@type': 'AdministrativeArea',
          name: area.county,
        },
      })),
      offers: {
        '@type': 'Offer',
        priceSpecification: {
          '@type': 'PriceSpecification',
          priceCurrency: 'AED',
          minPrice: service.priceRange.min,
          maxPrice: service.priceRange.max,
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}/services/` },
        { '@type': 'ListItem', position: 3, name: service.name },
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: service.name },
    ]}
  />

  <!-- Hero with background image -->
  <section class="relative isolate">
    <div class="absolute inset-0 -z-10">
      <img
        src={service.image}
        alt={`${service.name} service by ${business.name}`}
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal-950/90 via-charcoal-950/70 to-charcoal-950/40" />
    </div>
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
      <div class="max-w-2xl animate-fade-up">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur">
          <Icon name={service.icon} class="size-4" />
          Professional {service.name}
        </div>
        <h1 class="mt-6 font-display text-4xl text-white sm:text-5xl lg:text-6xl">
          {seo.h1}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-white/80">
          {seo.intro}
        </p>
        {service.priceRange.min > 0 || service.priceRange.max > 0 ? (
          <div class="mt-8 inline-flex items-center gap-2 rounded-lg bg-white/10 px-5 py-3 text-sm font-medium text-white ring-1 ring-white/20 backdrop-blur">
            <Icon name="lucide:banknote" class="size-4 text-accent-400" />
            Typical project range: AED {service.priceRange.min.toLocaleString()} – AED {service.priceRange.max.toLocaleString()}
          </div>
        ) : null}
      </div>
    </div>
  </section>

  <!-- Description -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <p class="text-lg leading-relaxed text-charcoal-600 lg:text-xl">
        {service.description}
      </p>
    </div>
  </section>

  <!-- Process Steps: Vertical Timeline -->
  <section class="bg-charcoal-50 py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <h2 class="font-display text-3xl text-charcoal-950 sm:text-4xl">
        Our {service.name} Process
      </h2>
      <p class="mt-4 text-charcoal-600">
        Every project follows a clear, proven process so you know exactly what to expect from start to finish.
      </p>

      <div class="relative mt-12">
        <div class="absolute left-[15px] top-2 bottom-2 w-px bg-brand-200 md:left-[19px]" />
        {service.processSteps.map((step, index) => (
          <div class="relative flex gap-6 pb-12 last:pb-0">
            <div class="relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white md:size-10">
              {index + 1}
            </div>
            <div class="flex-1 pt-1">
              <h3 class="font-display text-lg text-charcoal-950 md:text-xl">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-charcoal-600 md:text-base">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Areas -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="font-display text-3xl text-charcoal-950 sm:text-4xl">
        Areas We Serve for {service.name}
      </h2>
      <p class="mt-4 max-w-2xl text-charcoal-600">
        We provide {service.name.toLowerCase()} across Abu Dhabi. Select your area for local pricing and availability.
      </p>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceAreas.map((area) => (
          <a
            href={comboUrl(area.slug, service.slug)}
            class="group rounded-xl border border-charcoal-100 bg-white p-6 transition-all hover:border-brand-200 hover:shadow-md"
          >
            <div class="flex items-center gap-3">
              <Icon name="lucide:map-pin" class="size-5 text-brand-600" />
              <span class="font-semibold text-charcoal-800 group-hover:text-brand-700">
                {area.name}
              </span>
            </div>
            <p class="mt-2 text-sm text-charcoal-500">{area.county}</p>
            <p class="mt-1 text-xs text-charcoal-400">Response time: {area.responseTime}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <div class="border-t border-charcoal-100 bg-charcoal-50">
    <SeoFaq faqs={seo.faqs} heading={`Frequently Asked Questions About ${service.name}`} />
  </div>

  <!-- Testimonials -->
  {seo.testimonials.length > 0 && (
    <div class="border-t border-charcoal-100 bg-white">
      <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
        <SeoTestimonials testimonials={seo.testimonials} />
      </div>
    </div>
  )}

  <!-- CTA Banner -->
  <section class="bg-charcoal-950">
    <div class="mx-auto max-w-4xl px-5 py-20 text-center lg:px-8 lg:py-28">
      <h2 class="font-display text-3xl text-white sm:text-4xl">
        Need {service.name}?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-charcoal-300">
        {business.name} serves homes and villas across Abu Dhabi. Contact us today for a free consultation, home measurement, and tailored quotation.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={business.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-brand-700"
        >
          <Icon name="lucide:message-circle" class="size-5" />
          WhatsApp Us
        </a>
        <a
          href={contactUrl()}
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
        >
          <Icon name="lucide:mail" class="size-5" />
          Request a Quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
