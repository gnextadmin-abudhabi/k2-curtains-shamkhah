---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceUrl, contactUrl } from '../../lib/urls';

const servicesSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HomeGoodsStore',
      '@id': `${business.website}/#business`,
      name: business.name,
      telephone: business.phone,
      url: business.website,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '10:00',
          closes: '18:00',
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Curtain, Blind & Home Décor Services',
        description: `${business.name} offers custom curtains, blinds, flooring, upholstery, and home décor services for homes and villas across Abu Dhabi.`,
        itemListElement: serviceTypes.map((service, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Offer',
            name: service.name,
            description: service.shortDescription,
            url: `${business.website}${serviceUrl(service.slug)}`,
            priceCurrency: 'AED',
            price: service.priceRange.min,
          },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'Services' },
      ],
    },
  ],
};
---

<BaseLayout
  title={`Curtain & Blinds Services | ${business.name}`}
  description={`${business.name} offers a full range of custom curtains, blinds, flooring, upholstery, and home décor services across Abu Dhabi. From sheer curtains and blackout drapes to wooden flooring and sofa reupholstery.`}
  schema={servicesSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Services' }]} />

  <!-- Hero -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-5xl text-charcoal-950 sm:text-6xl">
          Our Services
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-charcoal-600">
          Whether you need custom curtains for a single bedroom or a complete home makeover with flooring, blinds, and upholstery, {business.name} provides end-to-end interior solutions for homes and villas throughout Abu Dhabi.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="bg-charcoal-50 pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid auto-rows-min gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {serviceTypes.map((service, i) => {
          const isTall = i % 4 === 0;
          return (
            <a
              href={serviceUrl(service.slug)}
              class:list={[
                'group relative flex flex-col overflow-hidden rounded-2xl border border-charcoal-100 bg-white shadow-sm transition-all hover:shadow-lg',
                isTall && 'lg:row-span-2',
              ]}
            >
              <div class:list={['relative overflow-hidden', isTall ? 'h-56 lg:h-80' : 'h-48']}>
                <img
                  src={service.image}
                  alt={service.name}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/50 to-transparent" />
                <div class="absolute bottom-4 left-4 flex size-10 items-center justify-center rounded-lg bg-white/95 text-brand-600 shadow-sm backdrop-blur">
                  <Icon name={service.icon} class="size-5" />
                </div>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h2 class="font-display text-xl text-charcoal-950">
                  {service.name}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-charcoal-600">
                  {service.shortDescription}
                </p>
                <div class="mt-auto pt-5">
                  {service.priceRange.min === 0 && service.priceRange.max === 0 ? (
                    <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-700">
                      Free
                    </span>
                  ) : (
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-semibold text-charcoal-950">
                        From AED {service.priceRange.min.toLocaleString()}
                      </span>
                      <span class="text-xs text-charcoal-400">
                        – up to AED {service.priceRange.max.toLocaleString()}
                      </span>
                    </div>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-charcoal-950">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:justify-between sm:text-left">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl text-white sm:text-4xl">
            Not Sure What You Need?
          </h2>
          <p class="mt-4 text-lg text-charcoal-300">
            Contact us and describe your project. We will recommend the right products and provide a tailored quotation with free home measurement.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap justify-center gap-4">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-brand-700"
          >
            <Icon name="lucide:message-circle" class="size-5" />
            WhatsApp
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
          >
            Request a Quote
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
