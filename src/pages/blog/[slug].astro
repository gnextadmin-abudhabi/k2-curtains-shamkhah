---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogUrl, contactUrl } from '../../lib/urls';
import { business } from '../../data/business';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const aSameCategory = a.data.category === post.data.category ? 1 : 0;
    const bSameCategory = b.data.category === post.data.category ? 1 : 0;
    if (aSameCategory !== bSameCategory) return bSameCategory - aSameCategory;
    return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
  })
  .slice(0, 3);

const categoryColors: Record<string, { bg: string; text: string }> = {
  emergency: { bg: 'bg-red-100', text: 'text-red-700' },
  tips: { bg: 'bg-brand-100', text: 'text-brand-700' },
  maintenance: { bg: 'bg-amber-100', text: 'text-amber-700' },
  news: { bg: 'bg-charcoal-200', text: 'text-charcoal-700' },
  guides: { bg: 'bg-brand-100', text: 'text-brand-700' },
  design: { bg: 'bg-rose-100', text: 'text-rose-700' },
  trends: { bg: 'bg-sky-100', text: 'text-sky-700' },
};

const colors = categoryColors[post.data.category] || categoryColors.news;

function formatDate(iso: string): string {
  const date = new Date(iso + 'T00:00:00');
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: business.website,
  },
  publisher: {
    '@type': 'Organization',
    name: business.name,
    url: business.website,
    telephone: business.phone,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${business.website}${blogUrl(post.id)}`,
  },
};
---

<BaseLayout
  title={`${post.data.title} | ${business.name}`}
  description={post.data.description}
  canonicalUrl={`${business.website}${blogUrl(post.id)}`}
  schema={schema}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label: post.data.title },
    ]}
  />

  <article class="mx-auto max-w-3xl px-5 py-16 lg:px-8 lg:py-24">
    <!-- ============ ARTICLE HEADER ============ -->
    <header class="pb-10 border-b border-charcoal-200/60">
      <div class="flex flex-wrap items-center gap-3">
        <span class={`inline-block rounded-full px-3 py-1 text-xs font-semibold capitalize ${colors.bg} ${colors.text}`}>
          {post.data.category}
        </span>
        {post.data.readingTime && (
          <span class="flex items-center gap-1 text-xs text-charcoal-400">
            <Icon name="lucide:clock" class="size-3" />
            {post.data.readingTime}
          </span>
        )}
      </div>

      <h1 class="mt-6 font-display text-3xl text-charcoal-950 sm:text-4xl lg:text-5xl">
        {post.data.title}
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-charcoal-500">
        <div class="flex items-center gap-1.5">
          <Icon name="lucide:calendar" class="size-4 text-charcoal-400" />
          <time datetime={post.data.publishDate}>
            {formatDate(post.data.publishDate)}
          </time>
        </div>
        <span class="hidden sm:inline text-charcoal-300">|</span>
        <div class="flex items-center gap-1.5">
          <Icon name="lucide:user" class="size-4 text-charcoal-400" />
          <span>{post.data.author}</span>
        </div>
      </div>

      {post.data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full border border-charcoal-200 bg-charcoal-50 px-3 py-1 text-xs text-charcoal-500">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- ============ CONTENT ============ -->
    <div class="prose-editorial mt-10">
      <Content />
    </div>

    <!-- ============ AUTHOR INFO BOX ============ -->
    <div class="mt-16 rounded-2xl border border-charcoal-200 bg-charcoal-50 p-6 lg:p-8">
      <div class="flex items-start gap-4">
        <div class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white">
          <Icon name="lucide:pen-tool" class="size-5" />
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-charcoal-400">
            Written by
          </h3>
          <p class="mt-1 text-lg font-semibold text-charcoal-800">
            {post.data.author}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
            {business.name} has been Abu Dhabi’s trusted source for custom curtains, blinds, flooring, and upholstery since {business.yearEstablished}. Our team shares practical tips and design inspiration to help you create a home you love.
          </p>
        </div>
      </div>
    </div>

    <!-- ============ CTA ============ -->
    <div class="mt-12 rounded-2xl border border-brand-200 bg-brand-50 p-6 lg:p-8">
      <h2 class="font-display text-xl text-charcoal-950">
        Need Help With Your Home Décor Project?
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
        If you have a project in mind or need expert advice on curtains, blinds, flooring, or upholstery, our team is ready to help. We serve homeowners across Abu Dhabi with free home consultation and professional installation.
      </p>
      <div class="mt-5 flex flex-wrap gap-4">
        <a
          href={business.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white shadow transition-colors hover:bg-accent-600"
        >
          <Icon name="lucide:message-circle" class="size-4" />
          WhatsApp Us
        </a>
        <a
          href={contactUrl()}
          class="inline-flex items-center gap-2 rounded-xl border border-brand-300 bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
        >
          <Icon name="lucide:mail" class="size-4" />
          Request a Quotation
        </a>
      </div>
    </div>
  </article>

  <!-- ============ RELATED POSTS ============ -->
  {relatedPosts.length > 0 && (
    <section class="border-t border-charcoal-200/60 bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <h2 class="font-display text-2xl text-charcoal-950 sm:text-3xl">
          Related Posts
        </h2>

        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((rp) => {
            const rpColors = categoryColors[rp.data.category] || categoryColors.news;
            return (
              <a
                href={blogUrl(rp.id)}
                class="group flex flex-col rounded-2xl border border-charcoal-200 bg-white overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
              >
                <div class="relative h-44 w-full bg-gradient-to-br from-brand-50 to-charcoal-100 flex items-center justify-center">
                  <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/80 shadow-sm">
                    <Icon name="lucide:image" class="size-6 text-charcoal-400" />
                  </div>
                </div>

                <div class="flex flex-1 flex-col p-5">
                  <span class={`self-start inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${rpColors.bg} ${rpColors.text}`}>
                    {rp.data.category}
                  </span>

                  <h3 class="mt-3 font-display text-lg text-charcoal-950 group-hover:text-brand-600 transition-colors">
                    {rp.data.title}
                  </h3>

                  <p class="mt-2 flex-1 text-sm leading-relaxed text-charcoal-600 line-clamp-2">
                    {rp.data.description}
                  </p>

                  <div class="mt-4 flex items-center gap-2 text-xs text-charcoal-400">
                    <Icon name="lucide:calendar" class="size-3.5" />
                    <time datetime={rp.data.publishDate}>
                      {formatDate(rp.data.publishDate)}
                    </time>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
