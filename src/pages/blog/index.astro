---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogUrl } from '../../lib/urls';
import { business } from '../../data/business';
import { Icon } from 'astro-icon/components';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const categoryColors: Record<string, { bg: string; text: string }> = {
  emergency: { bg: 'bg-red-100', text: 'text-red-700' },
  tips: { bg: 'bg-brand-100', text: 'text-brand-700' },
  maintenance: { bg: 'bg-amber-100', text: 'text-amber-700' },
  news: { bg: 'bg-charcoal-200', text: 'text-charcoal-700' },
  guides: { bg: 'bg-brand-100', text: 'text-brand-700' },
  design: { bg: 'bg-rose-100', text: 'text-rose-700' },
  trends: { bg: 'bg-sky-100', text: 'text-sky-700' },
};

function formatDate(iso: string): string {
  const date = new Date(iso + 'T00:00:00');
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Home Décor Tips & Insights | ${business.name}`,
  description: 'Practical advice, style guides, and industry insights on curtains, blinds, flooring, and upholstery from K2 Curtains Shamka.',
  url: `${business.website}/blog/`,
  publisher: {
    '@type': 'Organization',
    name: business.name,
    logo: {
      '@type': 'ImageObject',
      url: `${business.website}/images/logo.webp`,
    },
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate,
    author: {
      '@type': 'Organization',
      name: post.data.author,
    },
    url: `${business.website}${blogUrl(post.id)}`,
  })),
};
---

<BaseLayout
  title={`Home Décor Tips & Insights | ${business.name}`}
  description="Practical advice, style guides, and industry insights on curtains, blinds, flooring, and upholstery from K2 Curtains Shamka. Expert home décor tips for Abu Dhabi homeowners."
  schema={blogSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Blog' }]} />

  <!-- ============ HERO ============ -->
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl text-center mx-auto">
        <h1 class="font-display text-4xl text-charcoal-950 sm:text-5xl lg:text-6xl">
          Tips & Inspiration
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-charcoal-600">
          Practical advice, style guides, and industry insights from the team at
          {business.name}. Stay informed and make better decisions for your home.
        </p>
      </div>

      {posts.length === 0 ? (
        <p class="mt-16 text-center text-charcoal-500">
          No blog posts yet. Check back soon for curtain tips, blind comparisons, and flooring inspiration.
        </p>
      ) : (
        <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => {
            const colors = categoryColors[post.data.category] || categoryColors.news;
            return (
              <a
                href={blogUrl(post.id)}
                class="group flex flex-col rounded-2xl border border-charcoal-200 bg-white overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
              >
                <!-- Featured image placeholder -->
                <div class="relative h-48 w-full bg-gradient-to-br from-brand-50 to-charcoal-100 flex items-center justify-center">
                  <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/80 shadow-sm">
                    <Icon name="lucide:image" class="size-7 text-charcoal-400" />
                  </div>
                  {post.data.featured && (
                    <span class="absolute left-4 top-4 inline-flex items-center gap-1 rounded-full bg-accent-500 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-white shadow-sm">
                      <Icon name="lucide:sparkles" class="size-3" />
                      Featured
                    </span>
                  )}
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-center gap-3">
                    <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${colors.bg} ${colors.text}`}>
                      {post.data.category}
                    </span>
                    {post.data.readingTime && (
                      <span class="flex items-center gap-1 text-xs text-charcoal-400">
                        <Icon name="lucide:clock" class="size-3" />
                        {post.data.readingTime}
                      </span>
                    )}
                  </div>

                  <h2 class="mt-3 font-display text-xl text-charcoal-950 group-hover:text-brand-600 transition-colors">
                    {post.data.title}
                  </h2>

                  <p class="mt-2 flex-1 text-sm leading-relaxed text-charcoal-600">
                    {post.data.description}
                  </p>

                  <div class="mt-5 flex items-center gap-2 border-t border-charcoal-100 pt-4 text-xs text-charcoal-400">
                    <Icon name="lucide:calendar" class="size-3.5" />
                    <time datetime={post.data.publishDate}>
                      {formatDate(post.data.publishDate)}
                    </time>
                    <span class="text-charcoal-300">|</span>
                    <span>{post.data.author}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
