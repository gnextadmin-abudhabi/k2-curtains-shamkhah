---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../data/business';
import { serviceAreas } from '../data/serviceAreas';
import { areaUrl, contactUrl } from '../lib/urls';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${business.website}/about/#webpage`,
      url: `${business.website}/about/`,
      name: `About ${business.name}`,
      description: `Learn about ${business.name}, Abu Dhabi's trusted curtain and home décor shop serving homeowners since ${business.yearEstablished}.`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'LocalBusiness',
      additionalType: 'HomeGoodsStore',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '10:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Sunday',
          opens: '00:00',
          closes: '00:00',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`About ${business.name} | Custom Curtains & Blinds Abu Dhabi`}
  description={`Learn about ${business.name}, Abu Dhabi's trusted curtain and home décor shop serving homeowners since ${business.yearEstablished}. Free home consultation across Al Shamkha, Baniyas, Khalifa City, and beyond.`}
  schema={aboutSchema}
>
  <Breadcrumbs crumbs={[{ label: 'About' }]} />

  <!-- ============ HEADER ============ -->
  <section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-4xl text-brand-900 sm:text-5xl">
          About {business.name}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          Abu Dhabi's trusted curtain and home décor specialist. For over {yearsInBusiness()} years, we have been helping homeowners dress their windows, refresh their furniture, and transform their living spaces with quality craftsmanship and personal service.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ OUR STORY ============ -->
  <section class="pb-16 lg:pb-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="prose-editorial">
          <h2>Our Story</h2>
          <p>
            {business.name} was founded in {business.yearEstablished} with a simple mission: to give Abu Dhabi homeowners access to beautiful, made-to-measure curtains and blinds without the hassle of visiting multiple shops. We believed that choosing window treatments should be enjoyable, not overwhelming — and that the best way to do that is to bring the showroom to your door.
          </p>
          <p>
            Based on Hamdan Street in the Ziyani Area, we operate from a fully equipped workshop where our team of tailors, installers, and designers craft every curtain, blind, and upholstered piece by hand. This means we control quality from the first measurement to the final stitch.
          </p>
          <p>
            Over the years, we have fitted curtains and blinds in thousands of homes across Abu Dhabi — from villas in Al Shamkha and Baniyas to apartments on Yas Island and Al Raha. We have reupholstered family sofas, installed wooden flooring in new builds, and built traditional Arabic majlis seating that becomes the heart of the home.
          </p>
          <p>
            Our approach is simple: listen to what you need, recommend the right fabrics and finishes, deliver on time, and stand behind every product we install. That is why our clients recommend us to their neighbours, families, and friends.
          </p>
        </div>

        <div class="space-y-6">
          <img
            src="/images/hero-homepage.webp"
            alt="Elegant Abu Dhabi living room featuring custom curtains and modern home décor by K2 Curtains"
            class="w-full rounded-xl shadow-lg"
            width="1376"
            height="768"
            loading="lazy"
          />
          <div class="rounded-xl border border-stone-200 bg-white p-8">
            <div class="flex items-center gap-4">
              <div class="flex size-16 items-center justify-center rounded-full bg-brand-100">
                <Icon name="lucide:home" class="size-8 text-brand-700" />
              </div>
              <div>
                <h3 class="font-display text-xl text-brand-900">{business.legalName}</h3>
                <p class="text-sm text-stone-500">Curtains, Blinds & Home Décor</p>
              </div>
            </div>
            <div class="mt-6 space-y-3 text-sm leading-relaxed text-stone-600">
              <p>
                We specialize in custom curtains, Roman and roller blinds, Venetian blinds, motorized smart curtains, sofa upholstery, wooden flooring, carpets and rugs, designer wallpapers, and Arabic majlis seating. Every project starts with a free home consultation and ends with a quality-checked installation.
              </p>
              <p>
                Our team combines interior design expertise with hands-on craftsmanship, allowing us to handle everything from a single bedroom blind to a complete villa makeover — curtains, flooring, upholstery, and more.
              </p>
            </div>
            <div class="mt-6 border-t border-stone-100 pt-6">
              <p class="text-xs font-medium uppercase tracking-wider text-stone-400">Why Homeowners Choose Us</p>
              <div class="mt-2 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                  <Icon name="lucide:check-circle" class="size-3.5" />
                  Free Home Measure
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                  <Icon name="lucide:check-circle" class="size-3.5" />
                  Custom Fitted
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                  <Icon name="lucide:check-circle" class="size-3.5" />
                  15+ Years Trusted
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST SIGNALS ============ -->
  <section class="bg-stone-100 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="text-center font-display text-3xl text-brand-900">
        Why Homeowners Trust Us
      </h2>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            icon: 'lucide:ruler',
            title: 'Free Home Consultation',
            detail: 'We bring fabric samples to your door, measure every window precisely, and provide a detailed quote with no obligation.',
          },
          {
            icon: 'lucide:scissors',
            title: 'Made-to-Measure Quality',
            detail: 'Every curtain and blind is cut and stitched to your exact specifications for a perfect fit and a premium finish.',
          },
          {
            icon: 'lucide:truck',
            title: 'Fast, Clean Installation',
            detail: 'Our installers work neatly and efficiently, leaving your home spotless with perfectly aligned tracks, rods, and fittings.',
          },
          {
            icon: 'lucide:shield-check',
            title: 'Satisfaction Guaranteed',
            detail: 'We stand behind every product we make. If something is not right, we will adjust, replace, or refund — no questions asked.',
          },
        ].map((item, i) => (
          <div class={`rounded-xl border border-stone-200 bg-white p-6 animate-fade-up stagger-${i + 1}`}>
            <div class="flex size-12 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
              <Icon name={item.icon} class="size-6" />
            </div>
            <h3 class="mt-4 font-display text-lg text-brand-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.detail}</p>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <img
          src="/images/custom-curtains.webp"
          alt="Emerald velvet custom curtains beautifully installed in an Abu Dhabi villa living room by K2 Curtains"
          class="w-full rounded-xl shadow-lg"
          width="1376"
          height="768"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ============ AREAS WE COVER ============ -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="text-center font-display text-3xl text-brand-900">
        Areas We Serve
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-stone-600">
        We provide free home consultation and installation throughout Abu Dhabi and surrounding communities.
      </p>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceAreas.map((area) => (
          <a
            href={areaUrl(area.slug)}
            class="card-hover flex items-center gap-3 rounded-xl border border-stone-200 bg-white px-5 py-4 transition-colors"
          >
            <Icon name="lucide:map-pin" class="size-5 shrink-0 text-brand-600" />
            <div>
              <span class="font-medium text-brand-900">{area.name}</span>
              <span class="block text-xs text-stone-500">{area.county}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-brand-900">
    <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
      <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <h2 class="font-display text-3xl text-white">Ready to Transform Your Home?</h2>
          <p class="mt-2 text-brand-200">
            Get in touch for a free home consultation and quote. We look forward to helping you.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-4">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
          >
            <Icon name="lucide:message-circle" class="size-5" />
            WhatsApp
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-white/20"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
