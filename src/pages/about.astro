---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../data/business';
import { serviceAreas } from '../data/serviceAreas';
import { serviceTypes } from '../data/serviceTypes';
import { areaUrl, contactUrl } from '../lib/urls';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${business.website}/about/#webpage`,
      url: `${business.website}/about/`,
      name: `About ${business.name}`,
      description: `Learn about ${business.name}, Abu Dhabi's trusted curtain and home décor shop serving homeowners since ${business.yearEstablished}.`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'LocalBusiness',
      additionalType: 'HomeGoodsStore',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '10:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Sunday',
          opens: '00:00',
          closes: '00:00',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`About ${business.name} | Custom Curtains & Blinds Abu Dhabi`}
  description={`Learn about ${business.name}, Abu Dhabi's trusted curtain and home décor shop serving homeowners since ${business.yearEstablished}. Free home consultation across Al Shamkha, Baniyas, Khalifa City, and beyond.`}
  schema={aboutSchema}
>
  <Breadcrumbs crumbs={[{ label: 'About' }]} />

  <!-- ============ HERO ============ -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-5xl text-charcoal-950 sm:text-6xl">
          About K2 Curtains
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-charcoal-600">
          Abu Dhabi's trusted curtain and home décor specialist. For over {yearsInBusiness()} years, we have been helping homeowners dress their windows, refresh their furniture, and transform their living spaces with quality craftsmanship and personal service.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ OUR STORY ============ -->
  <section class="bg-white pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
        <!-- Left: Editorial text -->
        <div class="prose-editorial">
          <h2>Our Story</h2>
          <p>
            {business.name} was founded in {business.yearEstablished} with a simple mission: to give Abu Dhabi homeowners access to beautiful, made-to-measure curtains and blinds without the hassle of visiting multiple shops. We believed that choosing window treatments should be enjoyable, not overwhelming — and that the best way to do that is to bring the showroom to your door.
          </p>
          <p>
            Based on Hamdan Street in the Ziyani Area, we operate from a fully equipped workshop where our team of tailors, installers, and designers craft every curtain, blind, and upholstered piece by hand. This means we control quality from the first measurement to the final stitch.
          </p>
          <p>
            Over the years, we have fitted curtains and blinds in thousands of homes across Abu Dhabi — from villas in Al Shamkha and Baniyas to apartments on Yas Island and Al Raha. We have reupholstered family sofas, installed wooden flooring in new builds, and built traditional Arabic majlis seating that becomes the heart of the home.
          </p>
          <p>
            Our approach is simple: listen to what you need, recommend the right fabrics and finishes, deliver on time, and stand behind every product we install. That is why our clients recommend us to their neighbours, families, and friends.
          </p>

          <!-- Pull Quote -->
          <div class="mt-10 rounded-xl bg-brand-600 p-8 text-white">
            <Icon name="lucide:quote" class="size-8 text-brand-200" />
            <p class="mt-4 text-lg font-medium leading-relaxed">
              We don't just sell curtains — we help people fall in love with their homes again. Every stitch is a promise, and every installation is a relationship built on trust.
            </p>
            <p class="mt-4 text-sm text-brand-200">— The K2 Curtains Team</p>
          </div>
        </div>

        <!-- Right: Large image -->
        <div class="relative">
          <img
            src="/images/hero-homepage.webp"
            alt="Elegant Abu Dhabi living room featuring custom curtains and modern home décor by K2 Curtains"
            class="w-full rounded-2xl shadow-xl"
            width="1376"
            height="768"
            loading="lazy"
          />
          <div class="mt-8 flex items-center gap-4 rounded-xl border border-charcoal-100 bg-white p-6 shadow-sm">
            <img
              src="/images/logo-small.png"
              alt="K2 Curtains and Trading logo"
              class="h-12 w-auto"
              loading="lazy"
            />
            <div>
              <p class="font-display text-lg text-charcoal-800">{business.legalName}</p>
              <p class="text-sm text-charcoal-500">Curtains, Blinds & Home Décor</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="bg-stone-100 py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            value: `${yearsInBusiness()}+`,
            label: 'Years in Business',
            icon: 'lucide:calendar-check',
          },
          {
            value: `${serviceAreas.length}+`,
            label: 'Areas Served',
            icon: 'lucide:map-pin',
          },
          {
            value: `${serviceTypes.length - 1}+`,
            label: 'Services Offered',
            icon: 'lucide:layers',
          },
          {
            value: '5,000+',
            label: 'Happy Customers',
            icon: 'lucide:heart',
          },
        ].map((stat, i) => (
          <div class={`rounded-2xl bg-white p-8 text-center shadow-sm animate-fade-up stagger-${i + 1}`}>
            <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-brand-50 text-brand-600">
              <Icon name={stat.icon} class="size-7" />
            </div>
            <p class="mt-5 font-display text-4xl text-charcoal-950">{stat.value}</p>
            <p class="mt-2 text-sm font-medium text-charcoal-600">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="bg-stone-100 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-4xl text-charcoal-950">What We Stand For</h2>
        <p class="mt-4 text-lg text-charcoal-600">
          Three principles guide everything we do — from the first phone call to the final installation.
        </p>
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-3">
        {[
          {
            icon: 'lucide:gem',
            title: 'Quality Craftsmanship',
            detail: 'Every curtain is hand-stitched, every blind is precision-cut, and every installation is checked twice. We use premium fabrics and hardware because your home deserves nothing less.',
          },
          {
            icon: 'lucide:home',
            title: 'Free Consultation',
            detail: 'We bring the showroom to your door. Our consultants visit your home with fabric samples, take precise measurements, and provide a detailed quote — all with no obligation.',
          },
          {
            icon: 'lucide:wrench',
            title: 'Expert Installation',
            detail: 'Our installers are trained craftsmen who treat your home with respect. They work neatly, efficiently, and leave every room spotless with perfectly aligned fittings.',
          },
        ].map((item, i) => (
          <div class={`rounded-2xl bg-white p-10 shadow-sm animate-fade-up stagger-${i + 1}`}>
            <div class="flex size-16 items-center justify-center rounded-xl bg-brand-600 text-white">
              <Icon name={item.icon} class="size-8" />
            </div>
            <h3 class="mt-8 font-display text-2xl text-charcoal-950">{item.title}</h3>
            <p class="mt-4 leading-relaxed text-charcoal-600">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AREAS WE COVER ============ -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-4xl text-charcoal-950">Areas We Serve</h2>
        <p class="mt-4 text-lg text-charcoal-600">
          We provide free home consultation and installation throughout Abu Dhabi and surrounding communities.
        </p>
      </div>

      <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceAreas.map((area) => (
          <a
            href={areaUrl(area.slug)}
            class="card-hover flex items-center gap-3 rounded-xl border border-charcoal-100 bg-white px-5 py-4 transition-colors"
          >
            <Icon name="lucide:map-pin" class="size-5 shrink-0 text-brand-600" />
            <div>
              <span class="font-medium text-charcoal-800">{area.name}</span>
              <span class="block text-xs text-charcoal-500">{area.county}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-brand-600">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24">
      <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <h2 class="font-display text-3xl text-white lg:text-4xl">Ready to Transform Your Home?</h2>
          <p class="mt-3 text-lg text-brand-100">
            Get in touch for a free home consultation and quote. We look forward to helping you.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-4">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-8 py-4 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
          >
            <Icon name="lucide:message-circle" class="size-5" />
            WhatsApp
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-8 py-4 text-sm font-semibold text-white transition-all hover:bg-white/20"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
