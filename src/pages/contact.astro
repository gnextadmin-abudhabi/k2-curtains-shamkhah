---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${business.website}/contact/#webpage`,
      url: `${business.website}/contact/`,
      name: `Contact ${business.name}`,
      description: `Get in touch with ${business.name} for custom curtains, blinds, and home décor services in Abu Dhabi.`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'LocalBusiness',
      additionalType: 'HomeGoodsStore',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '10:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Sunday',
          opens: '00:00',
          closes: '00:00',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`Contact Us | ${business.name}`}
  description={`Get in touch with ${business.name} for a free home consultation and quote. Call ${business.phone}, WhatsApp, or fill out our contact form. Serving homeowners across Abu Dhabi.`}
  schema={contactSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Contact' }]} />

  <!-- ============ HERO ============ -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-5xl text-charcoal-950 sm:text-6xl">
          Get in Touch
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-charcoal-600">
          Have a project in mind or want to book a free home consultation? Reach out by phone, WhatsApp, email, or use the form below. We typically respond within one business day.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FORM + CONTACT INFO ============ -->
  <section class="bg-white pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-16 lg:grid-cols-5 lg:gap-20">
        <!-- Left: Contact Form (3 cols) -->
        <div class="lg:col-span-3">
          <div class="rounded-2xl border border-charcoal-100 bg-white p-8 shadow-sm sm:p-10">
            <h2 class="font-display text-2xl text-charcoal-950">Send Us a Message</h2>
            <p class="mt-2 text-charcoal-500">
              Fill out the form and we will get back to you as soon as possible.
            </p>

            <form action="#" method="POST" class="mt-10 space-y-6">
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="name" class="block text-sm font-medium text-charcoal-700">
                    Full Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Your name"
                    class="mt-2 w-full rounded-lg border border-charcoal-200 px-4 py-3 text-sm text-charcoal-900 placeholder-charcoal-400 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-charcoal-700">
                    Phone Number <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="+971 55 000 0000"
                    class="mt-2 w-full rounded-lg border border-charcoal-200 px-4 py-3 text-sm text-charcoal-900 placeholder-charcoal-400 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="email" class="block text-sm font-medium text-charcoal-700">
                    Email
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@example.com"
                    class="mt-2 w-full rounded-lg border border-charcoal-200 px-4 py-3 text-sm text-charcoal-900 placeholder-charcoal-400 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                  />
                </div>
                <div>
                  <label for="property" class="block text-sm font-medium text-charcoal-700">
                    Property Type
                  </label>
                  <select
                    id="property"
                    name="property"
                    class="mt-2 w-full rounded-lg border border-charcoal-200 bg-white px-4 py-3 text-sm text-charcoal-900 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                  >
                    <option value="">Select property type</option>
                    <option value="villa">Villa</option>
                    <option value="apartment">Apartment</option>
                    <option value="townhouse">Townhouse</option>
                    <option value="office">Office</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="area" class="block text-sm font-medium text-charcoal-700">
                    Your Area
                  </label>
                  <select
                    id="area"
                    name="area"
                    class="mt-2 w-full rounded-lg border border-charcoal-200 bg-white px-4 py-3 text-sm text-charcoal-900 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                  >
                    <option value="">Select your area</option>
                    {serviceAreas.map((area) => (
                      <option value={area.slug}>{area.name}</option>
                    ))}
                    <option value="other">Other Location</option>
                  </select>
                </div>
                <div>
                  <label for="service" class="block text-sm font-medium text-charcoal-700">
                    Service Interested In
                  </label>
                  <select
                    id="service"
                    name="service"
                    class="mt-2 w-full rounded-lg border border-charcoal-200 bg-white px-4 py-3 text-sm text-charcoal-900 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                  >
                    <option value="">Select a service</option>
                    {serviceTypes.map((service) => (
                      <option value={service.slug}>{service.name}</option>
                    ))}
                    <option value="other">Other / Not Sure</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-charcoal-700">
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Tell us about your project — number of windows, rooms, preferred styles, timeline, or any questions..."
                  class="mt-2 w-full rounded-lg border border-charcoal-200 px-4 py-3 text-sm text-charcoal-900 placeholder-charcoal-400 transition-colors focus:border-brand-600 focus:ring-2 focus:ring-brand-600/20 focus:outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-8 py-4 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md sm:w-auto"
              >
                <Icon name="lucide:send" class="size-4" />
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Contact Info Card (2 cols) -->
        <div class="lg:col-span-2">
          <div class="rounded-2xl border border-charcoal-100 bg-white p-8 shadow-sm sm:p-10">
            <h2 class="font-display text-2xl text-charcoal-950">Contact Information</h2>

            <ul class="mt-8 space-y-6">
              <li class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:phone" class="size-6 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-charcoal-800">Phone</p>
                  <a href={business.phoneHref} class="text-sm text-brand-600 transition-colors hover:text-brand-700">
                    {business.phone}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-accent-50">
                  <Icon name="lucide:message-circle" class="size-6 text-accent-500" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-charcoal-800">WhatsApp</p>
                  <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm text-accent-500 transition-colors hover:text-accent-600">
                    {business.whatsapp}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:mail" class="size-6 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-charcoal-800">Email</p>
                  <a href={`mailto:${business.email}`} class="text-sm text-brand-600 transition-colors hover:text-brand-700">
                    {business.email}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:map-pin" class="size-6 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-charcoal-800">Showroom</p>
                  <p class="text-sm text-charcoal-600">
                    {business.address.street}, {business.address.city}, {business.address.state}
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:clock" class="size-6 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-charcoal-800">Business Hours</p>
                  <div class="mt-1 space-y-0.5 text-sm text-charcoal-600">
                    {business.hours.map((schedule) => (
                      <p>
                        <span class="font-medium">{schedule.days}:</span> {schedule.hours}
                      </p>
                    ))}
                  </div>
                </div>
              </li>
            </ul>

            <div class="mt-10 rounded-xl bg-accent-50 p-6">
              <div class="flex items-start gap-3">
                <Icon name="lucide:message-circle" class="mt-0.5 size-5 shrink-0 text-accent-500" />
                <div>
                  <p class="text-sm font-semibold text-charcoal-800">Prefer WhatsApp?</p>
                  <p class="mt-1 text-sm text-charcoal-600">
                    Click to chat with us on WhatsApp at
                    <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-500 underline hover:text-accent-600">
                      {business.whatsapp}
                    </a>.
                    We typically reply within minutes during business hours.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MAP ============ -->
  <section class="bg-stone-100 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl text-charcoal-950">Visit Our Showroom</h2>
        <p class="mt-3 text-charcoal-600">
          Stop by our showroom in Al Shamkhah to see fabric samples and discuss your project in person.
        </p>
      </div>
      <div class="mt-12 overflow-hidden rounded-2xl border border-charcoal-100 shadow-sm">
        <iframe
          title="K2 Curtains Shamka Location"
          src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3631.0!2d${business.coordinates.lng}!3d${business.coordinates.lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjTCsDI0JzA2LjMiTiA1NMKwNDEnMjQuNCJF!5e0!3m2!1sen!2sae!4v1`}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
