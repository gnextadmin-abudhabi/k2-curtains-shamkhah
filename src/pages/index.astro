---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl, contactUrl } from '../lib/urls';
import { testimonialPool } from '../data/seoContent';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${business.website}/#website`,
      url: business.website,
      name: business.name,
      description: business.description,
      publisher: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'LocalBusiness',
      additionalType: 'HomeGoodsStore',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '10:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Sunday',
          opens: '00:00',
          closes: '00:00',
        },
      ],
      areaServed: serviceAreas.map((area) => ({
        '@type': 'City',
        name: area.name,
        containedInPlace: {
          '@type': 'AdministrativeArea',
          name: area.county,
        },
      })),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Curtains, Blinds & Home Décor Services',
        itemListElement: serviceTypes.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service.name,
            description: service.shortDescription,
          },
        })),
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${business.website}/#webpage`,
      url: business.website,
      name: `${business.name} | Custom Curtains & Blinds Abu Dhabi`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
      description: business.description,
    },
  ],
};

const featuredServices = [
  serviceTypes.find((s) => s.slug === 'custom-curtains'),
  serviceTypes.find((s) => s.slug === 'motorized-curtains'),
].filter(Boolean);

const smallServices = [
  serviceTypes.find((s) => s.slug === 'roman-blinds'),
  serviceTypes.find((s) => s.slug === 'roller-blinds'),
  serviceTypes.find((s) => s.slug === 'sofa-upholstery'),
  serviceTypes.find((s) => s.slug === 'wooden-flooring'),
].filter(Boolean);

const howItWorksSteps = [
  {
    title: 'Free Consultation',
    description:
      'Book a visit and we bring fabric samples to your door. Our consultant measures every window and discusses your style preferences and budget.',
    icon: 'lucide:home',
  },
  {
    title: 'Fabric Selection',
    description:
      'Browse hundreds of fabrics and finishes in your own lighting. We help you choose colours, textures, and styles that complement your interior.',
    icon: 'lucide:pen-tool',
  },
  {
    title: 'Tailoring',
    description:
      'Our experienced tailors cut and stitch every piece to exact measurements. Quality checks happen at every stage for a premium finish.',
    icon: 'lucide:scissors',
  },
  {
    title: 'Installation',
    description:
      'We install tracks, rods, blinds, or flooring with care and precision. We test every mechanism and leave your home spotless.',
    icon: 'lucide:check-circle',
  },
];

const featuredTestimonial = testimonialPool[0];
const moreTestimonials = testimonialPool.slice(1, 4);
---

<BaseLayout
  title={`${business.name} | Custom Curtains & Blinds Abu Dhabi`}
  description={business.description}
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-[85vh] items-center justify-center overflow-hidden">
    <img
      src="/images/hero-homepage.webp"
      alt="Modern Abu Dhabi living room with elegant custom curtains and soft natural light"
      class="absolute inset-0 h-full w-full object-cover"
      width="1376"
      height="768"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/90 via-charcoal-950/50 to-charcoal-950/20"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-5 py-24 text-center lg:px-8 lg:py-32">
      <div class="mb-8 flex justify-center">
        <img
          src="/images/logo-small.png"
          alt="K2 Curtains and Trading"
          class="h-16 w-auto brightness-0 invert opacity-90"
          width="120"
          height="64"
        />
      </div>
      <h1 class="font-display text-4xl leading-tight text-white sm:text-5xl lg:text-6xl">
        Custom Curtains, Blinds & Home Décor in Abu Dhabi
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-100">
        {business.tagline} From made-to-measure curtains and Roman blinds to wooden flooring, sofa
        upholstery, and Arabic majlis — we bring fabric samples to your door, measure every window,
        and install everything for a flawless finish.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={business.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-8 py-4 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600 hover:shadow-xl"
        >
          <Icon name="lucide:message-circle" class="size-5" />
          WhatsApp Us
        </a>
        <a
          href={business.phoneHref}
          class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-8 py-4 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20"
        >
          <Icon name="lucide:phone" class="size-5" />
          Call {business.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <section class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-6 lg:px-8">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {
          [
            { icon: 'lucide:ruler', label: 'Free Home Measure' },
            { icon: 'lucide:award', label: '15+ Years Experience' },
            { icon: 'lucide:check-circle', label: 'Custom Fitted' },
            { icon: 'lucide:shield-check', label: 'Satisfaction Guaranteed' },
          ].map((stat) => (
            <div class="flex items-center justify-center gap-3">
              <Icon name={stat.icon} class="size-5 shrink-0 text-brand-600" />
              <span class="text-sm font-semibold text-charcoal-800">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">What We Do</span>
        <h2 class="mt-3 font-display text-3xl text-charcoal-900 sm:text-4xl lg:text-5xl">
          Our Curtain & Home Décor Services
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-charcoal-600">
          From a single bedroom blind to a full villa makeover, we design, stitch, and install every
          detail.
        </p>
      </div>

      <!-- Desktop: Asymmetric grid -->
      <div class="mt-14 hidden gap-6 lg:grid lg:grid-cols-4">
        {
          featuredServices.map((service) => (
            <a
              href={serviceUrl(service!.slug)}
              class="card-hover group relative col-span-2 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200"
            >
              <div class="relative h-56 overflow-hidden">
                <img
                  src={service!.image}
                  alt={service!.name}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/60 to-transparent" />
              </div>
              <div class="p-6">
                <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100">
                  <Icon name={service!.icon} class="size-6" />
                </div>
                <h3 class="mt-4 font-display text-xl text-charcoal-900">{service!.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
                  {service!.shortDescription}
                </p>
                <p class="mt-3 text-sm font-semibold text-brand-700">
                  From AED {service!.priceRange.min.toLocaleString()}
                </p>
              </div>
            </a>
          ))
        }

        {
          smallServices.map((service) => (
            <a
              href={serviceUrl(service!.slug)}
              class="card-hover group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200"
            >
              <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100">
                <Icon name={service!.icon} class="size-6" />
              </div>
              <h3 class="mt-4 font-display text-lg text-charcoal-900">{service!.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-charcoal-600">
                {service!.shortDescription}
              </p>
              <p class="mt-3 text-sm font-semibold text-brand-700">
                From AED {service!.priceRange.min.toLocaleString()}
              </p>
            </a>
          ))
        }
      </div>

      <!-- Mobile: Horizontal scroll -->
      <div class="mt-10 flex gap-5 overflow-x-auto pb-4 lg:hidden [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {[...featuredServices, ...smallServices].map((service) => (
          <a
            href={serviceUrl(service!.slug)}
            class="card-hover group w-72 shrink-0 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200"
          >
            <div class="relative h-40 overflow-hidden">
              <img
                src={service!.image}
                alt={service!.name}
                class="h-full w-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950/60 to-transparent" />
            </div>
            <div class="p-5">
              <h3 class="font-display text-lg text-charcoal-900">{service!.name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-charcoal-600 line-clamp-2">
                {service!.shortDescription}
              </p>
              <p class="mt-2 text-sm font-semibold text-brand-700">
                From AED {service!.priceRange.min.toLocaleString()}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="bg-stone-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">
          Simple Process
        </span>
        <h2 class="mt-3 font-display text-3xl text-charcoal-900 sm:text-4xl lg:text-5xl">
          How It Works
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-charcoal-600">
          From your first call to the final installation, we keep things simple and stress-free.
        </p>
      </div>

      <div class="relative mx-auto mt-16 max-w-4xl">
        <!-- Vertical line -->
        <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-brand-200 lg:left-1/2 lg:-translate-x-1/2" />

        {
          howItWorksSteps.map((step, i) => (
            <div class="relative grid grid-cols-1 gap-8 py-8 lg:grid-cols-2 lg:gap-16">
              <!-- Content -->
              <div
                class:list={[
                  'pl-20 lg:pl-0',
                  i % 2 === 0 ? 'lg:pr-16 lg:text-right' : 'lg:col-start-2 lg:pl-16',
                ]}
              >
                <span class="text-xs font-bold uppercase tracking-wider text-brand-600">
                  Step {i + 1}
                </span>
                <h3 class="mt-2 font-display text-2xl text-charcoal-900">{step.title}</h3>
                <p class="mt-3 leading-relaxed text-charcoal-600">{step.description}</p>
              </div>

              <!-- Center dot -->
              <div class="absolute left-8 top-10 -translate-x-1/2 flex size-12 items-center justify-center rounded-full bg-brand-600 text-white shadow-lg lg:left-1/2 lg:top-12">
                <Icon name={step.icon} class="size-5" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">
          Testimonials
        </span>
        <h2 class="mt-3 font-display text-3xl text-charcoal-900 sm:text-4xl lg:text-5xl">
          What Our Clients Say
        </h2>
        <div class="mt-4 flex items-center justify-center gap-2">
          <div class="flex items-center gap-0.5">
            {[1, 2, 3, 4, 5].map(() => (
              <Icon name="lucide:star" class="size-5 fill-amber-400 text-amber-400" />
            ))}
          </div>
          <span class="text-sm font-medium text-charcoal-600">
            {(testimonialPool.reduce((sum, r) => sum + r.rating, 0) / testimonialPool.length).toFixed(
              1,
            )}{' '}
            average from {testimonialPool.length} reviews
          </span>
        </div>
      </div>

      <!-- Featured testimonial -->
      <div class="mt-14 flex justify-center">
        <div class="max-w-3xl rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-stone-200 sm:p-12">
          <div class="flex justify-center gap-0.5">
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon
                name="lucide:star"
                class={`size-6 ${i < Math.floor(featuredTestimonial.rating) ? 'fill-amber-400 text-amber-400' : 'text-stone-200'}`}
              />
            ))}
          </div>
          <blockquote class="mt-6 font-display text-xl italic leading-relaxed text-charcoal-800 sm:text-2xl">
            "{featuredTestimonial.text}"
          </blockquote>
          <div class="mt-8 flex items-center justify-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-full bg-brand-100 text-base font-semibold text-brand-700">
              {featuredTestimonial.author.charAt(0)}
            </div>
            <div class="text-left">
              <p class="text-base font-semibold text-charcoal-800">{featuredTestimonial.author}</p>
              <p class="text-sm text-charcoal-500">{featuredTestimonial.location}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Smaller testimonial cards -->
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {moreTestimonials.map((review) => (
          <div class="rounded-xl border border-stone-200/60 bg-stone-50 p-6">
            <div class="flex items-center gap-0.5">
              {Array.from({ length: 5 }).map((_, i) => (
                <Icon
                  name="lucide:star"
                  class={`size-4 ${i < Math.floor(review.rating) ? 'fill-amber-400 text-amber-400' : 'text-stone-200'}`}
                />
              ))}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-charcoal-600 line-clamp-4">
              "{review.text}"
            </p>
            <div class="mt-4 flex items-center gap-3">
              <div class="flex size-9 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">
                {review.author.charAt(0)}
              </div>
              <div>
                <p class="text-sm font-semibold text-charcoal-800">{review.author}</p>
                <p class="text-xs text-charcoal-500">{review.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="bg-stone-100 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <span class="text-sm font-semibold uppercase tracking-wider text-brand-600">
          Service Area
        </span>
        <h2 class="mt-3 font-display text-3xl text-charcoal-900 sm:text-4xl lg:text-5xl">
          Areas We Serve
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-charcoal-600">
          Proudly serving homeowners and villas across {business.serviceRadius} with free home
          consultation and fast installation.
        </p>
      </div>

      <!-- Mobile: Horizontal scroll -->
      <div class="mt-10 flex gap-4 overflow-x-auto pb-4 lg:hidden [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {serviceAreas.map((area) => (
          <a
            href={areaUrl(area.slug)}
            class="card-hover w-64 shrink-0 rounded-xl bg-white p-5 shadow-sm ring-1 ring-stone-200"
          >
            <div class="flex items-center gap-3">
              <Icon name="lucide:map-pin" class="size-5 text-brand-600" />
              <h3 class="font-display text-lg text-charcoal-900">{area.name}</h3>
            </div>
            <p class="mt-1 text-sm text-charcoal-500">{area.county}</p>
            <div class="mt-3 flex items-center gap-1.5 text-sm text-charcoal-600">
              <Icon name="lucide:clock" class="size-4 text-brand-500" />
              <span>{area.responseTime} response</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Desktop: 4-column grid -->
      <div class="mt-14 hidden gap-6 lg:grid lg:grid-cols-4">
        {serviceAreas.map((area) => (
          <a
            href={areaUrl(area.slug)}
            class="card-hover group rounded-xl bg-white p-6 shadow-sm ring-1 ring-stone-200"
          >
            <div class="flex items-center gap-3">
              <Icon name="lucide:map-pin" class="size-5 text-brand-600" />
              <h3 class="font-display text-lg text-charcoal-900">{area.name}</h3>
            </div>
            <p class="mt-1 text-sm text-charcoal-500">{area.county}</p>
            <div class="mt-3 flex items-center gap-1.5 text-sm text-charcoal-600">
              <Icon name="lucide:clock" class="size-4 text-brand-500" />
              <span>{area.responseTime} response</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA BANNER ============ -->
  <section class="bg-brand-600">
    <div class="mx-auto max-w-4xl px-5 py-20 text-center lg:px-8 lg:py-24">
      <h2 class="font-display text-3xl text-white sm:text-4xl lg:text-5xl">
        Ready to Transform Your Home?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100">
        Get in touch for a free home consultation and quote. We serve homeowners across Abu Dhabi.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={business.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-8 py-4 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
        >
          <Icon name="lucide:message-circle" class="size-5" />
          WhatsApp Us
        </a>
        <a
          href={contactUrl()}
          class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-8 py-4 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
