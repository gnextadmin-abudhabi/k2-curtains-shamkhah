---
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceAreas, getAreaBySlug, getNearbyAreas } from '../../data/serviceAreas';
import { generateAreaSeoContent } from '../../data/seoContent';
import { comboUrl, areaUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';
import SeoTestimonials from '../../components/SeoTestimonials.astro';
import SeoRelatedLinks from '../../components/SeoRelatedLinks.astro';
import SeoServiceAreas from '../../components/SeoServiceAreas.astro';

import type { ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;

const nearbyAreas = getNearbyAreas(area);
const seoContent = generateAreaSeoContent(area.slug);

const pageTitle = seoContent.title;
const metaDescription = seoContent.metaDescription;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  description: `${business.name} provides custom curtains, blinds, flooring, and upholstery in ${area.name}, ${area.county}.`,
  telephone: business.phone,
  url: business.website,
  address: {
    '@type': 'PostalAddress',
    addressLocality: area.name,
    addressRegion: area.county,
    addressCountry: 'AE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: area.lat,
    longitude: area.lng,
  },
  areaServed: [
    { '@type': 'City', name: area.name },
    { '@type': 'AdministrativeArea', name: area.county },
  ],
  openingHoursSpecification: business.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.hours === 'Closed' ? undefined : '10:00',
    closes: h.hours === 'Closed' ? undefined : '18:00',
  })),
  priceRange: '$$',
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <Breadcrumbs
    crumbs={[
      { label: 'Service Areas', href: '/areas/' },
      { label: area.name },
    ]}
  />

  <!-- ============ HERO ============ -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
        <div class="lg:col-span-2">
          <h1 class="font-display text-3xl text-charcoal-950 sm:text-4xl lg:text-5xl">
            {seoContent.h1}
          </h1>

          <p class="mt-6 text-lg leading-relaxed text-charcoal-600">
            {seoContent.intro}
          </p>

          <p class="mt-4 leading-relaxed text-charcoal-600">
            {business.name} proudly serves homeowners in {area.name} and surrounding communities. Whether you need custom blackout curtains for a master bedroom, elegant Roman blinds for a living room, engineered oak flooring for a villa, or a complete Arabic majlis seating arrangement, our team delivers beautiful, made-to-measure results with free home consultation and professional installation.
          </p>
        </div>

        <div class="lg:col-span-1">
          <div class="rounded-2xl border border-charcoal-200 bg-white p-6 shadow-sm lg:p-8">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-charcoal-400">
              Quick Facts
            </h2>

            <dl class="mt-6 space-y-5">
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-charcoal-400">Region</dt>
                <dd class="mt-1 text-sm font-semibold text-charcoal-800">{area.county}</dd>
              </div>

              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-charcoal-400">Population</dt>
                <dd class="mt-1 text-sm font-semibold text-charcoal-800">
                  {area.population.toLocaleString()}
                </dd>
              </div>

              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-charcoal-400">Response Time</dt>
                <dd class="mt-1 flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                  <Icon name="lucide:clock" class="size-4" />
                  {area.responseTime}
                </dd>
              </div>
            </dl>

            <div class="mt-8 space-y-3 border-t border-charcoal-100 pt-6">
              <a
                href={business.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent-500 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-600"
              >
                <Icon name="lucide:message-circle" class="size-4" />
                WhatsApp
              </a>
              <a
                href={business.phoneHref}
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
              >
                <Icon name="lucide:phone" class="size-4" />
                {business.phone}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES AVAILABLE ============ -->
  <section class="border-t border-charcoal-200/60 bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl text-charcoal-950 sm:text-3xl lg:text-4xl">
          Services Available in {area.name}
        </h2>
        <p class="mt-4 text-charcoal-600">
          Our team handles everything from a single window blind to a full-home curtain and flooring package. Select a service below for details and pricing specific to {area.name}.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {serviceTypes.map((service) => (
          <a
            href={comboUrl(area.slug, service.slug)}
            class="group flex flex-col rounded-2xl border border-charcoal-200/60 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg"
          >
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50">
              <Icon name={service.icon} class="size-6 text-brand-600" />
            </div>

            <h3 class="mt-4 text-base font-semibold text-charcoal-800 group-hover:text-brand-600 transition-colors">
              {service.name}
            </h3>

            <p class="mt-2 flex-1 text-sm leading-relaxed text-charcoal-500">
              {service.shortDescription}
            </p>

            <p class="mt-4 text-xs font-semibold text-brand-600">
              AED {service.priceRange.min.toLocaleString()} – AED {service.priceRange.max.toLocaleString()}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NEARBY AREAS ============ -->
  {nearbyAreas.length > 0 && (
    <section class="py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="max-w-2xl">
          <h2 class="font-display text-2xl text-charcoal-950 sm:text-3xl lg:text-4xl">
            Nearby Areas We Serve
          </h2>
          <p class="mt-4 text-charcoal-600">
            In addition to {area.name}, our service area covers these nearby residential communities.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {nearbyAreas.map((nearby) => (
            <a
              href={areaUrl(nearby.slug)}
              class="group flex items-start gap-4 rounded-2xl border border-charcoal-200/60 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-md"
            >
              <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                <Icon name="lucide:map-pin" class="size-5 text-brand-600" />
              </div>
              <div>
                <span class="font-semibold text-charcoal-800 group-hover:text-brand-600 transition-colors">
                  {nearby.name}
                </span>
                <p class="mt-1 text-sm text-charcoal-500">{nearby.county}</p>
                <p class="mt-1 text-xs text-charcoal-400">
                  Population: {nearby.population.toLocaleString()}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ FAQ ============ -->
  <div class="border-t border-charcoal-200/60 bg-white">
    <SeoFaq faqs={seoContent.faqs} heading={`Frequently Asked Questions — ${area.name}`} />
  </div>

  <!-- ============ TESTIMONIALS ============ -->
  <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <SeoTestimonials testimonials={seoContent.testimonials} />
  </div>

  <!-- ============ RELATED LINKS ============ -->
  <div class="mx-auto max-w-7xl px-5 pb-20 lg:px-8 lg:pb-28">
    <SeoRelatedLinks area={area} />
    <SeoServiceAreas currentArea={area} />
  </div>

  <!-- ============ CTA ============ -->
  <section class="bg-charcoal-950 py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-5 text-center lg:px-8">
      <h2 class="font-display text-2xl text-white sm:text-3xl lg:text-4xl">
        Need Curtains, Blinds, or Flooring in {area.name}?
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-charcoal-400">
        {business.name} is locally based in Abu Dhabi and serves homes throughout {area.county}. Contact us today for a free home consultation and no-obligation quote.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={business.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-accent-600 hover:shadow-md"
        >
          <Icon name="lucide:message-circle" class="size-4" />
          WhatsApp Us
        </a>
        <a
          href={contactUrl()}
          class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:bg-white/20"
        >
          <Icon name="lucide:mail" class="size-4" />
          Request a Quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
