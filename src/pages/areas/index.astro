---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceAreas } from '../../data/serviceAreas';
import { areaUrl, contactUrl } from '../../lib/urls';

function cardStyle(index: number) {
  const styles = [
    { bg: 'bg-white', border: 'border-charcoal-200', iconBg: 'bg-brand-50', iconColor: 'text-brand-600' },
    { bg: 'bg-brand-50/40', border: 'border-brand-200', iconBg: 'bg-white', iconColor: 'text-brand-600' },
    { bg: 'bg-white', border: 'border-charcoal-200', iconBg: 'bg-accent-50', iconColor: 'text-accent-500' },
    { bg: 'bg-accent-50/30', border: 'border-accent-200', iconBg: 'bg-white', iconColor: 'text-accent-500' },
  ];
  return styles[index % styles.length];
}

function priorityClasses(priority: string): string {
  switch (priority) {
    case 'primary':
      return 'bg-brand-100 text-brand-700';
    case 'secondary':
      return 'bg-charcoal-100 text-charcoal-700';
    case 'tertiary':
      return 'bg-charcoal-50 text-charcoal-500';
    default:
      return 'bg-charcoal-50 text-charcoal-500';
  }
}

const areasSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Service Areas',
  description: `${business.name} provides custom curtains, blinds, flooring, and upholstery across Abu Dhabi.`,
  itemListElement: serviceAreas.map((area, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: area.name,
    description: area.description,
    url: `${business.website}${areaUrl(area.slug)}`,
  })),
};
---

<BaseLayout
  title={`Curtains & Blinds Service Areas | ${business.name}`}
  description={`${business.name} serves homes and villas across Abu Dhabi with custom curtains, blinds, flooring, and upholstery. See our service areas, response times, and coverage for your location.`}
  schema={areasSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Service Areas' }]} />

  <!-- ============ HERO ============ -->
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-4xl text-charcoal-950 sm:text-5xl lg:text-6xl">
          Areas We Serve
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-charcoal-600">
          Based in Abu Dhabi, {business.name} provides premium home décor services — custom curtains, Roman and roller blinds, wooden flooring, sofa upholstery, and Arabic majlis seating — throughout the emirate. We know these communities because we are part of them, and we are committed to fast response times and free home consultations no matter where you live.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ AREAS GRID ============ -->
  <section class="pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {serviceAreas.map((area, i) => {
          const style = cardStyle(i);
          return (
            <a
              href={areaUrl(area.slug)}
              class={`group rounded-2xl border ${style.border} ${style.bg} p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg animate-fade-up stagger-${Math.min(i + 1, 6)}`}
            >
              <div class="flex items-center justify-between">
                <div class={`inline-flex items-center justify-center rounded-xl ${style.iconBg} p-2.5`}>
                  <Icon name="lucide:map-pin" class={`size-5 ${style.iconColor}`} />
                </div>
                <span class={`inline-block rounded-full px-2.5 py-0.5 text-[11px] font-semibold capitalize ${priorityClasses(area.priority)}`}>
                  {area.priority}
                </span>
              </div>

              <h2 class="mt-4 font-display text-xl text-charcoal-950 group-hover:text-brand-600 transition-colors">
                {area.name}
              </h2>
              <p class="mt-1 text-sm text-charcoal-500">{area.county}</p>

              <div class="mt-4 flex items-center gap-4 text-sm text-charcoal-600">
                <span class="flex items-center gap-1.5">
                  <Icon name="lucide:users" class="size-4 text-charcoal-400" />
                  {area.population.toLocaleString()}
                </span>
                <span class="flex items-center gap-1.5">
                  <Icon name="lucide:clock" class="size-4 text-brand-600" />
                  {area.responseTime}
                </span>
              </div>

              <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-charcoal-500">
                {area.description}
              </p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ CTA BANNER ============ -->
  <section class="bg-charcoal-950">
    <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
      <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:justify-between sm:text-left">
        <div class="max-w-xl">
          <h2 class="font-display text-3xl text-white sm:text-4xl">
            Not Sure If We Cover Your Area?
          </h2>
          <p class="mt-3 text-charcoal-400">
            Get in touch. If you are anywhere in Abu Dhabi, we can visit your home with fabric samples and a measuring tape.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap justify-center gap-4">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
          >
            <Icon name="lucide:message-circle" class="size-5" />
            WhatsApp
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:bg-white/20"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
